# Copy to backend/.env and fill in. Never commit the real .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Set DATABASE_URL *or* the DB_* block. Required whenever DEBUG=False.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
IMPORT_ALERT_EMAIL=

# ── Website / Webhook Integration ─────────────────────────────────────────────
WEBSITE_API_KEY=
WEBHOOK_SECRET_KEY=

# ── Google Sheets Sync ────────────────────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS=config/credentials/google-sheets.json
GOOGLE_SHEET_ID=
